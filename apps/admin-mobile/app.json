{
  "expo": {
    "name": "Cal-Eats Admin",
    "slug": "cal-eats-admin",
    "scheme": "caleatsadmin",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "info.calai.caleatsadmin",
      "config": {
        "usesNonExemptEncryption": false
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "info.calai.caleatsadmin",
      "versionCode": 1,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo for a Cal-Eats menu item.",
          "cameraPermission": "Take a photo for a Cal-Eats menu item.",
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "6282b87e-36ae-43bb-80b7-12d69108a411"
      }
    },
    "owner": "yankee1707",
    "icon": "./assets/app-icon.png",
    "backgroundColor": "#121212",
    "primaryColor": "#2865E9"
  }
}
