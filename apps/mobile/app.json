{
  "expo": {
    "name": "Cal-Eats",
    "slug": "cal-eats",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android"
    ],
    "android": {
      "package": "uk.co.calai.caleats",
      "permissions": [],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uk.co.calai.caleats",
      "appleTeamId": "HB56AJWWY2",
      "config": {
        "usesNonExemptEncryption": false
      },
      "buildNumber": "1"
    },
    "plugins": [
      "./plugins/with-live-order-brand.cjs",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "uk.co.calai.caleats.liveorderwidget",
          "groupIdentifier": "group.uk.co.calai.caleats.liveorders",
          "enablePushNotifications": true,
          "enableAndroid": false,
          "frequentUpdates": false,
          "widgets": []
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "cal-eats-updates-quiet-v2",
          "icon": "./assets/notification-icon.png",
          "color": "#2865E9",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ],
      [
        "expo-location",
        {
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "locationWhenInUsePermission": "Allow Cal-Eats to find a nearby postcode when you choose Use my location.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ]
    ],
    "scheme": "caleats",
    "icon": "./assets/app-icon.png",
    "backgroundColor": "#F1F8FF",
    "primaryColor": "#2865E9",
    "owner": "yankee1707",
    "extra": {
      "eas": {
        "projectId": "5bf59184-c670-44f4-be78-5229cbd02300"
      }
    }
  }
}
