{
  "expo": {
    "name": "Cal-Eats",
    "slug": "cal-eats",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android"
    ],
    "android": {
      "package": "uk.co.calai.caleats",
      "permissions": [],
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uk.co.calai.caleats",
      "config": {
        "usesNonExemptEncryption": false
      },
      "buildNumber": "1"
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Cal-Eats to select a refund evidence photo.",
          "cameraPermission": "Allow Cal-Eats to take a refund evidence photo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ],
      [
        "expo-location",
        {
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "locationWhenInUsePermission": "Allow Cal-Eats to find a nearby postcode when you choose Use my location.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ]
    ],
    "scheme": "caleats",
    "icon": "./assets/app-icon.png",
    "backgroundColor": "#F1F8FF",
    "primaryColor": "#2865E9",
    "owner": "yankee1707",
    "extra": {
      "eas": {
        "projectId": "5bf59184-c670-44f4-be78-5229cbd02300"
      }
    }
  }
}
