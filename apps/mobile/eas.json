{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://eats.calai.info"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://eats.calai.info",
        "CAL_EATS_PUBLIC_RELEASE_BUILD": "true"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      }
    },
    "store-test": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://eats.calai.info",
        "CAL_EATS_STORE_DISTRIBUTION": "testing",
        "CAL_EATS_PUBLIC_RELEASE_BUILD": "false"
      }
    },
    "android-store-test": {
      "extends": "store-test",
      "credentialsSource": "local",
      "env": {
        "CAL_EATS_EXPO_OWNER": "bondu17",
        "CAL_EATS_EAS_PROJECT_ID": "f76a2adf-34ca-438a-9208-bdb5d4e65ded",
        "CAL_EATS_BUILD_PLATFORM": "android"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6831180948",
        "appleTeamId": "HB56AJWWY2"
      }
    },
    "store-test": {
      "extends": "production"
    }
  }
}
