# Local preview only. Copy to .env and change values for your machine.
CALAI_RUN_MODE=local
CALAI_HOST=127.0.0.1
CALAI_PORT=4310
CALAI_ORIGIN=http://127.0.0.1:4310
CALAI_DB_PATH=data/calai-eats.sqlite
CALAI_ORDER_EXPIRY_MINUTES=15
# Keep the simulator selected until the isolated Cal-Eats Stripe sandbox is connected.
CALAI_PAYMENT_PROVIDER=local_simulator
CALAI_LIVE_PAYMENTS_ENABLED=false
# Stripe secrets belong only in private local/server settings, never in this file or chat.
# CALAI_STRIPE_ACCOUNT_ID=acct_...
# CALAI_STRIPE_TEST_SECRET_KEY=
# Prefer a restricted rk_test_ key with only the required payment/Connect permissions.
# CALAI_STRIPE_TEST_WEBHOOK_SECRET=
# CALAI_STRIPE_TEST_CONNECT_WEBHOOK_SECRET=
# Live additionally requires NODE_ENV=production, hosted HTTPS and the explicit live flag.
# CALAI_STRIPE_LIVE_SECRET_KEY=
# CALAI_STRIPE_LIVE_WEBHOOK_SECRET=
# CALAI_STRIPE_LIVE_CONNECT_WEBHOOK_SECRET=
# Ordinary order chats remain visible for this many hours after completion (0–24).
CALAI_MESSAGE_SUPPORT_HOURS=2
# Hosted preview messaging requires a separately generated 32-byte base64 key.
# Keep keys outside database backups and never commit their values.
# CALAI_MESSAGE_ENCRYPTION_KEY=
# Local mode creates a private key beside its database unless this file is set.
# CALAI_MESSAGE_KEY_FILE=
# Mail is local-only until a separate approved sender connection is enabled.
CALAI_ORDER_ALERT_EMAIL_MODE=local
# CALAI_ORDER_ALERT_RECIPIENT=owner@example.com
CALAI_ORDER_ALERT_FROM=caleats-support@calai.info
CALAI_MAIL_GRAPH_ENABLED=false
# CALAI_MAIL_GRAPH_TENANT_ID=
# CALAI_MAIL_GRAPH_CLIENT_ID=
# For a shared mailbox, use an approved member's licensed sign-in account.
# CALAI_MAIL_GRAPH_SIGN_IN_USER=operator@example.com
# Local sign-in uses an encrypted, Git-ignored cache and separate 32-byte key.
# CALAI_MAIL_GRAPH_CACHE_FILE=data/cal-eats-mail.cache
# CALAI_MAIL_GRAPH_KEY_FILE=data/.cal-eats-mail-key
# Hosted sender requires a separately provisioned encrypted cache and key secret.
# CALAI_MAIL_GRAPH_ENCRYPTION_KEY=
