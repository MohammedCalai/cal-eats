# Local preview only. Copy to .env and change values for your machine.
CALAI_RUN_MODE=local
CALAI_HOST=127.0.0.1
CALAI_PORT=4310
CALAI_ORIGIN=http://127.0.0.1:4310
CALAI_DB_PATH=data/calai-eats.sqlite
CALAI_ORDER_EXPIRY_MINUTES=15
# Ordinary order chats remain visible for this many hours after completion (0–24).
CALAI_MESSAGE_SUPPORT_HOURS=2
# Hosted preview messaging requires a separately generated 32-byte base64 key.
# Keep keys outside database backups and never commit their values.
# CALAI_MESSAGE_ENCRYPTION_KEY=
# Local mode creates a private key beside its database unless this file is set.
# CALAI_MESSAGE_KEY_FILE=
