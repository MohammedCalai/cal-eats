{
  "name": "calai-eats",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "calai-eats",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "engines": {
        "node": "24.19.0",
        "npm": "11.17.0"
      }
    },
    "apps/api": {
      "name": "@calai/api",
      "version": "0.1.0",
      "dependencies": {
        "@calai/contracts": "0.1.0"
      }
    },
    "apps/web": {
      "name": "@calai-eats/web"
    },
    "node_modules/@calai-eats/web": {
      "resolved": "apps/web",
      "link": true
    },
    "node_modules/@calai/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@calai/contracts": {
      "resolved": "packages/contracts",
      "link": true
    },
    "packages/contracts": {
      "name": "@calai/contracts",
      "version": "0.1.0"
    }
  }
}
