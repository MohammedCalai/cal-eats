index 0000000000000000000000000000000000000000..d80945bcc491f99d9f077736c15b8b719e49fb50
--- /dev/null
+++ b/frontend/src/components/cal-eats/CalEatsWorkspace.jsx
@@ -0,0 +1,172 @@
+import { createContext, useCallback, useContext, useEffect, useRef, useState } from 'react';
+import { Icon } from '@iconify/react';
+import { Link, NavLink, useLocation } from 'react-router-dom';
+import useAuth from '../../hooks/useAuth';
+import { WORKSPACE_TOOLS, displayOrderCount, displayTotalCount, navigateWorkspaceMessage, requestedWorkspace, workspaceIframeAllow, workspaceOrigin, workspacePath, workspaceStateFromMessage, workspaceViewForPath } from './workspace-model.mjs';
+
+const Workspace = createContext(null);
+const childOrigin = workspaceOrigin(import.meta.env.DEV, import.meta.env.VITE_CAL_EATS_LOCAL_PREVIEW_ORIGIN);
+const childUrl = new URL('/business/embedded', childOrigin).href;
+const companies = [['calai', 'Calai phone orders'], ['cal-eats', 'Cal-Eats online orders']];
+const money = new Intl.NumberFormat('en-GB', { style: 'currency', currency: 'GBP' });
+const time = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/London' });
+const connectionPanel = 'mb-4 rounded-2xl border border-[#2a3b57] bg-[#142033] p-4 text-sm text-blue-100';
+
+function readWorkspaceIntent(identity) {
+  try { return sessionStorage.getItem('calai:combined-workspace') === identity; }
+  catch { return false; }
+}
+
+function saveWorkspaceIntent(identity, enabled) {
+  try {
+    if (enabled) sessionStorage.setItem('calai:combined-workspace', identity);
+    else if (readWorkspaceIntent(identity)) sessionStorage.removeItem('calai:combined-workspace');
+  } catch { /* Combined navigation still works without tab storage. */ }
+}
+
+export function CalEatsWorkspaceProvider({ children }) {
+  const { user } = useAuth();
+  const { pathname, search } = useLocation();
+  const identity = user?.role === 'BUSINESS_OWNER' && user.id && user.businessId && pathname.startsWith('/owner/')
+    ? `${user.id}:${user.businessId}` : null;
+  const desiredView = workspaceViewForPath(pathname);
+  const requested = requestedWorkspace(pathname, search);
+  const [enabledFor, setEnabledFor] = useState(() => identity && readWorkspaceIntent(identity) ? identity : null);
+  const enabled = Boolean(identity && (requested === 'both' || (requested !== 'calai' && enabledFor === identity)));
+  useEffect(() => {
+    if (!identity) {
+      setEnabledFor(null);
+      return;
+    }
+    if (requested === 'both' || requested === 'calai') {
+      setEnabledFor(requested === 'both' ? identity : null);
+      saveWorkspaceIntent(identity, requested === 'both');
+    }
+  }, [identity, requested]);
+
+  return <WorkspaceConnection key={enabled ? identity : 'standalone'} enabled={enabled} user={user} desiredView={desiredView}>
+    {children}
+  </WorkspaceConnection>;
+}
+
+function WorkspaceConnection({ children, enabled, user, desiredView }) {
+  const frameRef = useRef(null);
+  const [state, setState] = useState(null);
+  const [stale, setStale] = useState(false);
+  const connected = !stale && state?.combined === true;
+  const canOpen = connected && WORKSPACE_TOOLS.some(tool => tool.view === desiredView && state.capabilities[tool.permission]);
+  const showAccounts = desiredView === 'accounts' && !stale && (state?.authenticated === false || state?.matchesNativeAccount === true);
+  const visible = Boolean(canOpen || showAccounts);
+  const sendView = useCallback(view => {
+    frameRef.current?.contentWindow?.postMessage(navigateWorkspaceMessage(view), childOrigin);
+  }, []);
+
+  useEffect(() => {
+    if (!enabled) return;
+    let deadline;
+    function waitForProof(ms) {
+      clearTimeout(deadline);
+      deadline = setTimeout(() => setStale(true), ms);
+    }
+    function receive(event) {
+      const next = workspaceStateFromMessage(event, frameRef.current?.contentWindow, user, childOrigin);
+      if (!next) return;
+      setState(next);
+      setStale(false);
+      waitForProof(65_000);
+    }
+    waitForProof(15_000);
+    window.addEventListener('message', receive);
+    return () => { clearTimeout(deadline); window.removeEventListener('message', receive); };
+  }, [enabled, user?.id, user?.businessId, user?.role]);
+
+  const view = visible ? desiredView : connected ? 'dashboard' : 'accounts';
+  useEffect(() => { if (enabled) sendView(view); }, [enabled, view, sendView]);
+  return <Workspace.Provider value={{ enabled, connected, state, stale, frameRef, desiredView, visible, view, sendView }}>
+    {children}
+  </Workspace.Provider>;
+}
+
+export function CalEatsWorkspaceNavigation({ collapsed = false, onNavigate }) {
+  const current = useContext(Workspace);
+  if (!current?.enabled) return null;
+  const tools = current.connected ? WORKSPACE_TOOLS.filter(tool => current.state.capabilities[tool.permission]) : [];
+  const items = [...tools, { view: 'accounts', label: 'Accounts & connections', icon: 'lucide:link-2' }];
+  return <section aria-label="Cal-Eats navigation" className="mt-5 border-t border-[#262626] pt-3">
+    <p className={`px-2 pb-2 text-xs font-semibold text-blue-200 ${collapsed ? '2xl:sr-only' : ''}`}>Cal-Eats</p>
+    {items.map(({ view, label, icon }) => <NavLink key={view} to={workspacePath(view)} onClick={onNavigate}
+      aria-label={`Cal-Eats ${label}`}
+      className={({ isActive }) => `flex items-center gap-4 rounded-xl border border-l-4 px-2 py-3.5 transition-colors ${collapsed ? '2xl:justify-center 2xl:px-0' : ''} ${isActive ? 'border-blue-600/30 border-l-blue-600 bg-[#18181A] text-white' : 'border-transparent text-gray-300 hover:bg-[#18181A] hover:text-white'}`}>
+      <Icon icon={icon} width="24" className="shrink-0" aria-hidden="true" />
+      <span className={`whitespace-nowrap text-sm ${collapsed ? '2xl:hidden' : ''}`}>{label}</span>
+    </NavLink>)}
+  </section>;
+}
+
+export function CalEatsCombinedCounters() {
+  const current = useContext(Workspace);
+  if (!current?.connected) return null;
+  const state = current.state;
+  const counts = [...companies.map(([product, label]) => [label, displayOrderCount(state, product)]), ['Total orders', displayTotalCount(state)]];
+  return <section aria-label="Today’s orders across Calai and Cal-Eats" className="mb-6 space-y-3">
+    <h2 className="text-xl font-semibold text-white">Today’s orders</h2>
+    <div className="grid gap-3 sm:grid-cols-3">
+      {counts.map(([label, value]) => <div key={label} className="rounded-2xl border border-[#2a3b57] bg-[#142033] p-4">
+        <p className="text-sm text-blue-100">{label}</p>
+        <p className="mt-2 text-2xl font-semibold text-white">{value}</p>
+      </div>)}
+    </div>
+    {state.orders.length > 0 && <div className="rounded-2xl border border-[#2a3b57] bg-[#141b2a] p-4">
+      <h3 className="mb-2 font-semibold text-white">Recent orders</h3>
+      <ul className="divide-y divide-white/10">
+        {state.orders.map((order, index) => <li key={`${order.source}:${order.createdAt}:${index}`} className="grid grid-cols-[1.7fr_1.3fr_auto] items-center gap-2 py-2 text-sm text-gray-200">
+          <span><span className={`inline-block rounded-full px-2 py-1 text-xs font-semibold ${order.source === 'calai' ? 'bg-indigo-500/20 text-indigo-200' : 'bg-sky-500/20 text-sky-100'}`}>
+            {order.source === 'calai' ? 'Calai phone' : 'Cal-Eats online'}
+          </span><span className="ml-2 hidden text-xs text-gray-300 sm:inline">{time.format(new Date(order.createdAt))}</span></span>
+          <span className="capitalize">{order.status.replaceAll('_', ' ')}</span>
+          <span>{order.totalMinor === null ? '—' : money.format(order.totalMinor / 100)}</span>
+        </li>)}
+      </ul>
+    </div>}
+  </section>;
+}
+
+function connectionMessage(current) {
+  if (current.stale) return 'Cal-Eats is temporarily unavailable.';
+  if (!current.state) return 'Connecting to Cal-Eats…';
+  if (!current.state.authenticated) return 'Sign in to Cal-Eats to connect this workspace.';
+  if (!current.state.matchesNativeAccount) return 'The Cal-Eats account is linked to a different Calai login or location.';
+  return 'Cal-Eats access for this page is unavailable.';
+}
+
+export function CalEatsEmbeddedPage() {
+  const current = useContext(Workspace);
+  if (current?.enabled) return null;
+  return <section className={connectionPanel}><Link to="/owner/dashboard?workspace=both" className="font-semibold text-white underline">Open the combined workspace</Link></section>;
+}
+
+export function CalEatsWorkspaceSurface({ children }) {
+  const current = useContext(Workspace);
+  if (!current?.enabled) return children;
+  const { frameRef, connected, state, desiredView, visible, view, sendView } = current;
+  const policy = document.permissionsPolicy?.features ? document.permissionsPolicy : document.featurePolicy;
+  const iframeAllow = workspaceIframeAllow(policy?.features?.(), childOrigin);
+  const pending = connected ? state.pendingOrderCount ?? 0 : 0;
+  return <>
+    {!visible && pending > 0 && <div className={connectionPanel} role="status">
+      <Link className="font-semibold text-white underline" to={workspacePath('orders')}>
+        {pending} {pending === 1 ? 'Cal-Eats order awaiting confirmation' : 'Cal-Eats orders awaiting confirmation'}
+      </Link>
+    </div>}
+    {desiredView && (!visible || !connected) && <div className={connectionPanel} role="status">
+      <p>{connectionMessage(current)}</p>
+      {desiredView !== 'accounts' && <Link className="underline" to={workspacePath('accounts')}>Accounts &amp; connections</Link>}
+    </div>}
+    {!desiredView && children}
+    <div className={visible ? 'w-full' : 'pointer-events-none absolute left-0 top-0 size-px overflow-hidden opacity-0'} aria-hidden={!visible} inert={!visible}>
+      <iframe ref={frameRef} src={childUrl} allow={iframeAllow} title="Cal-Eats business workspace" tabIndex={visible ? 0 : -1} referrerPolicy="strict-origin"
+        sandbox="allow-scripts allow-same-origin allow-forms allow-downloads allow-modals allow-popups allow-popups-to-escape-sandbox"
+        onLoad={() => sendView(view)} className="block h-[calc(100dvh-9rem)] min-h-[32rem] w-full rounded-2xl border border-[#294769] bg-[#101722]" />
+    </div>
+  </>;
+}
diff --git a/frontend/src/components/cal-eats/workspace-model.mjs b/frontend/src/components/cal-eats/workspace-model.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..c9e2fd3b44dc106cb2385a09bd0eb203ecca506e
--- /dev/null
+++ b/frontend/src/components/cal-eats/workspace-model.mjs
@@ -0,0 +1,124 @@
+export const CAL_EATS_ORIGIN = 'https://eats.calai.info';
+export const CAL_EATS_EMBED = CAL_EATS_ORIGIN + '/business/embedded';
+export const WORKSPACE_STATE = 'cal-eats-workspace:state';
+export const WORKSPACE_NAVIGATE = 'cal-eats-workspace:navigate';
+export const WORKSPACE_TOOLS = Object.freeze([
+  { view: 'orders', label: 'Orders', icon: 'lucide:receipt-text', permission: 'viewOrders' },
+  { view: 'menu', label: 'Menu', icon: 'lucide:notebook-tabs', permission: 'manageMenu' },
+  { view: 'inbox', label: 'Inbox', icon: 'lucide:message-square', permission: 'viewInbox' },
+  { view: 'customers', label: 'Customers', icon: 'lucide:users', permission: 'viewCustomers' },
+  { view: 'offers', label: 'Marketing', icon: 'lucide:tag', permission: 'manageMarketing' },
+  { view: 'support', label: 'Support', icon: 'lucide:life-buoy', permission: 'viewSupport' },
+  { view: 'devices', label: 'Printers', icon: 'lucide:printer', permission: 'viewDevices' },
+  { view: 'payouts', label: 'Earnings & payouts', icon: 'lucide:wallet', permission: 'viewPayouts' },
+  { view: 'settings', label: 'Settings', icon: 'lucide:settings', permission: 'manageSettings' },
+]);
+export const WORKSPACE_VIEWS = Object.freeze(['dashboard', 'accounts', ...WORKSPACE_TOOLS.map(tool => tool.view)]);
+
+export function workspaceOrigin(development, previewOrigin) {
+  if (development && typeof previewOrigin === 'string' && /^http:\/\/127\.0\.0\.1:[1-9]\d{0,4}$/.test(previewOrigin)) {
+    const port = Number(previewOrigin.split(':').at(-1));
+    if (port <= 65535) return previewOrigin;
+  }
+  return CAL_EATS_ORIGIN;
+}
+
+export function requestedWorkspace(pathname, search) {
+  if (pathname !== '/owner/dashboard') return null;
+  const workspace = new URLSearchParams(search).getAll('workspace');
+  return workspace.length === 1 && ['both', 'calai'].includes(workspace[0]) ? workspace[0] : null;
+}
+
+const bothQuery = '?workspace=both';
+
+export function workspaceLoginPath(pathname, search) {
+  const presentationPath = pathname === '/auth/login' ? '/owner/dashboard' : pathname;
+  const suffix = requestedWorkspace(presentationPath, search) === 'both' ? bothQuery : '';
+  return '/auth/login' + suffix;
+}
+
+export function ownerDashboardAfterLogin(search) {
+  const suffix = requestedWorkspace('/owner/dashboard', search) === 'both' ? bothQuery : '';
+  return '/owner/dashboard' + suffix;
+}
+// A modern browser can delegate loopback without also granting LAN access.
+// Older managed Edge uses its documented combined Local Network Access token.
+// Delegation is limited to this child origin; it never authorises a terminal.
+export function workspaceIframeAllow(supportedFeatures = [], origin = CAL_EATS_ORIGIN) {
+  const loopbackFeature = Array.isArray(supportedFeatures) && supportedFeatures.includes('loopback-network') ? 'loopback-network' : 'local-network-access';
+  return `autoplay ${origin}; ${loopbackFeature} ${origin}`;
+}
+const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+const isId = value => typeof value === 'string' && UUID.test(value);
+const plain = value => Boolean(value && typeof value === 'object' && !Array.isArray(value) && Object.getPrototypeOf(value) === Object.prototype);
+const bounded = (value, size) => typeof value === 'string' && value.length > 0 && value.length <= size && !/[\u0000-\u001f\u007f]/.test(value);
+const sameId = (a, b) => typeof a === 'string' && typeof b === 'string' && UUID.test(a) && UUID.test(b) && a.toLowerCase() === b.toLowerCase();
+const permitted = product => product.adminAllowed && product.linked && product.ready;
+const validCount = value => Number.isSafeInteger(value) && value >= 0;
+function product(value) {
+  if (!plain(value) || ['adminAllowed', 'linked', 'ready'].some(key => typeof value[key] !== 'boolean') || !bounded(value.effectiveStatus, 64)) return null;
+  return { adminAllowed: value.adminAllowed, linked: value.linked, ready: value.ready, effectiveStatus: value.effectiveStatus };
+}
+function counter(value) {
+  if (!plain(value) || typeof value.available !== 'boolean' || value.today !== null && (!Number.isSafeInteger(value.today) || value.today < 0)) return null;
+  if (value.available && value.today === null) return null;
+  return { available: value.available, today: value.available ? value.today : null };
+}
+export function workspaceStateFromMessage(event, sourceWindow, nativeUser, origin = CAL_EATS_ORIGIN) {
+  if (!sourceWindow || event?.source !== sourceWindow || event.origin !== origin) return null;
+  const value = event.data;
+  if (!plain(value) || value.type !== WORKSPACE_STATE || value.version !== 1 || typeof value.authenticated !== 'boolean') return null;
+  if (!value.authenticated) return { authenticated: false, business: null, products: null, counters: null, capabilities: {}, orders: [], pendingOrderCount: null, matchesNativeAccount: false, combined: false };
+  if (!plain(value.business) || !isId(value.business.id) || !bounded(value.business.name, 160) || !plain(value.products) || !plain(value.counters)) return null;
+  const calai = product(value.products.calai), eats = product(value.products['cal-eats']);
+  const calaiCounter = counter(value.counters.calai), eatsCounter = counter(value.counters['cal-eats']);
+  if (!calai || !eats || !calaiCounter || !eatsCounter) return null;
+  const source = value.products.calai;
+  eats.sourceAccountId = isId(value.products['cal-eats'].sourceAccountId) ? value.products['cal-eats'].sourceAccountId : null;
+  const matchesNativeAccount = nativeUser?.role === 'BUSINESS_OWNER' && sameId(source.sourceAccountId, nativeUser.businessId) && sameId(source.verifiedSourceUserId, nativeUser.id);
+  const scopedMode = value.workspaceMode === 'both' &&
+    (value.principalKind === 'terminal' && value.tabletMode === 'both' ||
+     value.principalKind === 'human' && (value.tabletMode === null || value.tabletMode === 'both'));
+  const combined = matchesNativeAccount && scopedMode && permitted(calai) && permitted(eats);
+  const capabilities = {};
+  for (const { permission } of WORKSPACE_TOOLS) capabilities[permission] = combined && plain(value.capabilities) && value.capabilities[permission] === true;
+  const orders = combined && capabilities.viewOrders ? recentOrders(value.orders) : [];
+  const pendingOrderCount = combined && capabilities.viewOrders && validCount(value.pendingOrderCount) ? value.pendingOrderCount : null;
+  const counters = combined ? { calai: calaiCounter, 'cal-eats': eatsCounter } : null;
+  return { authenticated: true, business: combined ? { id: value.business.id, name: value.business.name } : null, counters, capabilities, orders, pendingOrderCount, matchesNativeAccount, combined };
+}
+
+const orderStatuses = new Set(['received', 'unconfirmed', 'confirmed', 'placed', 'accepted', 'preparing', 'ready', 'out_for_delivery', 'completed', 'rejected']);
+function recentOrders(orders) {
+  if (!Array.isArray(orders)) return [];
+  return orders.slice(0, 8).filter(row => plain(row) && ['calai', 'cal-eats'].includes(row.source)
+      && orderStatuses.has(row.status) && typeof row.createdAt === 'string' && Number.isFinite(Date.parse(row.createdAt))
+      && ['delivery', 'collection', 'takeaway', 'unknown'].includes(row.fulfilment))
+    .map(({ source, status, createdAt, fulfilment, totalMinor }) => ({
+      source, status, createdAt, fulfilment, totalMinor: validCount(totalMinor) ? totalMinor : null,
+    }));
+}
+export function navigateWorkspaceMessage(view) {
+  if (!WORKSPACE_VIEWS.includes(view)) throw new Error('Unsupported Cal-Eats workspace view');
+  return { type: WORKSPACE_NAVIGATE, version: 1, view };
+}
+export function workspaceViewForPath(pathname) {
+  if (pathname === '/owner/accounts-connections') return 'accounts';
+  const match = /^\/owner\/cal-eats\/([a-z]+)$/.exec(pathname);
+  return match && WORKSPACE_TOOLS.some(tool => tool.view === match[1]) ? match[1] : null;
+}
+export function workspacePath(view) {
+  if (view === 'accounts') return '/owner/accounts-connections';
+  if (!WORKSPACE_TOOLS.some(tool => tool.view === view)) throw new Error('Use the native Calai dashboard route');
+  return '/owner/cal-eats/' + view;
+}
+export function displayOrderCount(state, productName) {
+  const value = state?.counters?.[productName];
+  return value?.available && Number.isSafeInteger(value.today) ? String(value.today) : 'Unavailable';
+}
+export function displayTotalCount(state) {
+  const counters = ['calai', 'cal-eats'].map(product => state?.counters?.[product]);
+  if (!counters.every(counter => counter?.available === true && validCount(counter.today))) return 'Unavailable';
+  const sum = counters[0].today + counters[1].today;
+  return Number.isSafeInteger(sum) ? String(sum) : 'Unavailable';
+}
diff --git a/frontend/src/components/cal-eats/workspace-model.test.mjs b/frontend/src/components/cal-eats/workspace-model.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..0ecdf0216396420c83df936d79c626419be367a0
