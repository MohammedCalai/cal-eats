+import { useId } from 'react';
+import { Link } from 'react-router-dom';
+import { workspacePath } from './workspace-model.mjs';
+import './combined-live-activity.css';
+
+function LiveOrderOrbitArt({ live }) {
+  const id = `live-order-${useId().replace(/[^a-zA-Z0-9_-]/g, "")}`;
+  const blue = live ? "#3184ff" : "#40516b", cyan = live ? "#b8ebff" : "#9eacc0";
+  return <svg className="live-order-orbit-art" aria-hidden="true" viewBox="0 0 256 256" fill="none">
+    <defs>
+      <linearGradient id={`${id}-shell`} x1="53" y1="21" x2="205" y2="238" gradientUnits="userSpaceOnUse"><stop stopColor="#617ba7"/><stop offset=".18" stopColor="#243b60"/><stop offset=".57" stopColor="#0a1425"/><stop offset=".84" stopColor="#32466e"/><stop offset="1" stopColor="#0c1729"/></linearGradient>
+      <linearGradient id={`${id}-rim`} x1="39" y1="27" x2="221" y2="227" gradientUnits="userSpaceOnUse"><stop stopColor={cyan}/><stop offset=".25" stopColor={blue}/><stop offset=".56" stopColor={live ? "#2853bd" : "#27344e"}/><stop offset=".82" stopColor={live ? "#5494ff" : "#62718d"}/><stop offset="1" stopColor="#182846"/></linearGradient>
+      <radialGradient id={`${id}-face`} cx=".27" cy=".15" r=".92"><stop stopColor={live ? "#293f62" : "#293240"}/><stop offset=".45" stopColor={live ? "#15283f" : "#1b2532"}/><stop offset="1" stopColor="#0c1626"/></radialGradient>
+      <linearGradient id={`${id}-edge`} x1="73" y1="23" x2="173" y2="232" gradientUnits="userSpaceOnUse"><stop stopColor="#c4e8ff" stopOpacity=".72"/><stop offset=".38" stopColor="#6d9acd" stopOpacity=".12"/><stop offset="1" stopColor="#0a1221" stopOpacity=".78"/></linearGradient>
+      <linearGradient id={`${id}-glass`} x1="98" y1="28" x2="143" y2="143" gradientUnits="userSpaceOnUse"><stop stopColor="#d5eeff" stopOpacity=".115"/><stop offset="1" stopColor="#d5eeff" stopOpacity="0"/></linearGradient>
+      <clipPath id={`${id}-clip`}><circle cx="128" cy="128" r="109"/></clipPath>
+    </defs>
+    <circle cx="128" cy="128" r="124" fill="#030a14" opacity=".3"/>
+    <circle cx="128" cy="128" r="121.3" fill={`url(#${id}-shell)`} stroke="#7f9bc0" strokeOpacity=".22" strokeWidth=".8"/>
+    <circle cx="128" cy="128" r="117" stroke={`url(#${id}-rim)`} strokeWidth="6.3"/>
+    <circle cx="128" cy="128" r="112.8" fill={`url(#${id}-face)`} stroke={`url(#${id}-edge)`} strokeWidth="1.8"/>
+    <g clipPath={`url(#${id}-clip)`}><path d="M4 46C64-1 173 0 248 48L248 116C182 97 86 142 8 113Z" fill={`url(#${id}-glass)`}/></g>
+    <circle cx="128" cy="128" r="106" stroke="#b6dbff" strokeOpacity=".045" strokeWidth=".8"/>
+    <path d="M36 64A116 116 0 0 1 135 12" stroke="#e2f7ff" strokeOpacity={live ? ".7" : ".3"} strokeWidth="1.25" strokeLinecap="round"/>
+    <path d="M233 167A113 113 0 0 1 163 235" stroke={live ? "#5a9fff" : "#5c7293"} strokeOpacity=".5" strokeWidth="1.1" strokeLinecap="round"/>
+  </svg>;
+}
+function LiveOrderOrbit({ value, label, active, announcement }) {
+  return <div className="live-order-orbit">
+    <LiveOrderOrbitArt live={active}/>
+    <strong role="status" aria-atomic="true" aria-label={announcement}>{value ?? "—"}</strong>
+    <small>{label}</small>
+  </div>;
+}
+
+function ServiceCard({ product, value, label, unavailable, daily, link, linkText, children }) {
+  return <article className={`both-activity-card both-activity-card--${product === 'Calai' ? 'calai' : 'eats'}`}>
+    <div className="both-activity-heading">
+      <h3>{product}</h3>
+      {daily !== null && <span>{daily} {product === 'Calai' ? 'phone' : 'online'} {daily === 1 ? 'order' : 'orders'} today</span>}
+    </div>
+    <LiveOrderOrbit value={value?.toLocaleString('en-GB')} label={label}
+      active={value > 0} announcement={value == null ? unavailable : value + ' ' + (value === 1 ? label.slice(0, -1) : label).toLowerCase()}/>
+    <div className="both-activity-stages">{value == null ? <span>{unavailable}</span> : children}</div>
+    <Link className="both-activity-link" to={link}>{linkText}<span aria-hidden="true">→</span></Link>
+  </article>;
+}
+
+export default function CombinedLiveActivity({ state, total }) {
+  const calls = state.calaiLiveCalls;
+  const orders = state.eatsLiveOrders;
+  return <>
+    <div className="both-activity-title">
+      <h2>Live activity</h2>
+      <span>{total === 'Unavailable' ? 'Today’s total unavailable' : <><strong>{total}</strong> {total === '1' ? 'order' : 'orders'} today</>}</span>
+    </div>
+    <div className="both-activity-grid">
+      <ServiceCard product="Calai" value={calls?.activeCalls} label="LIVE CALLS" unavailable="Live calls unavailable"
+        daily={state.counters.calai.today} link="/owner/order-list" linkText="View phone orders">
+        {calls && <><span>{calls.agentsInUse} {calls.agentsInUse === 1 ? 'agent' : 'agents'} in use</span><span>{calls.ringing} ringing</span><span>{calls.queued} queued</span><span>{calls.forwarding} forwarded</span></>}
+      </ServiceCard>
+      <ServiceCard product="Cal-Eats" value={orders?.liveOrders} label="LIVE ORDERS" unavailable="Live orders unavailable"
+        daily={state.counters['cal-eats'].today} link={workspacePath('orders')} linkText="Manage online orders">
+        {orders && <><span>{orders.pendingConfirmation} to confirm</span><span>{orders.confirmedInKitchen} preparing</span><span>{orders.readyForHandover} ready</span></>}
+      </ServiceCard>
+    </div>
+  </>;
+}
diff --git a/frontend/src/components/cal-eats/business-message-audio.js b/frontend/src/components/cal-eats/business-message-audio.js
new file mode 100644
index 0000000000000000000000000000000000000000..7822adf35bd4006909c07f85f0398d4582776fa8
--- /dev/null
+++ b/frontend/src/components/cal-eats/business-message-audio.js
@@ -0,0 +1,110 @@
+export const BUSINESS_MESSAGE_REPEAT_MS = 10_000;
+const numericRevision = value => Number.isSafeInteger(value) && value >= 0 ? value : 0;
+const validScope = value => typeof value === "string" ? value.trim() : "";
+
+/** Sound prompts attention until a conversation is successfully read. Acknowledging
+ * attention never changes any conversation's unread badge or server read cursor. */
+export function createBusinessMessageAudio(player, {
+  schedule = (callback, delay) => setTimeout(callback, delay),
+  cancel = handle => clearTimeout(handle)
+} = {}) {
+  if (typeof player?.play !== "function" || typeof player?.pause !== "function") throw new TypeError("A message melody player is required");
+  const listeners = new Set();
+  const acknowledged = new Map();
+  let current = { scope: "", enabled: false, pending: false, revision: 0, orderAlarmActive: false };
+  let timer = null, active = null, generation = 0, repeatDue = false;
+  let state = Object.freeze({ ...current, acknowledgedRevision: -1, playing: false, blocked: false, error: "" });
+  function publish(patch = {}) {
+    const next = { ...state, ...current, acknowledgedRevision: acknowledged.get(current.scope) ?? -1, ...patch };
+    if (Object.keys(next).every(key => next[key] === state[key])) return;
+    state = Object.freeze(next);
+    for (const listener of listeners) listener(state);
+  }
+  function eligible() {
+    return Boolean(current.scope && current.enabled && current.pending && current.revision > (acknowledged.get(current.scope) ?? -1) && !current.orderAlarmActive);
+  }
+  function clearRepeat() {
+    if (timer !== null) cancel(timer);
+    timer = null;
+    repeatDue = false;
+  }
+  function silence({ alwaysPause = false } = {}) {
+    clearRepeat();
+    generation++;
+    const hadActive = Boolean(active);
+    active = null;
+    if (hadActive || alwaysPause) {
+      try { player.pause(); } catch { /* Playback must remain disabled even if the underlying player fails to stop. */ }
+    }
+    publish({ playing: false, blocked: false, error: "" });
+  }
+  function start() {
+    if (!eligible() || active || state.blocked) return;
+    clearRepeat();
+    const attempt = ++generation;
+    active = { attempt, scope: current.scope };
+    publish({ playing: true, blocked: false, error: "" });
+    // The cadence is measured from each start. A longer melody must finish before another can start.
+    timer = schedule(() => {
+      timer = null;
+      if (!eligible()) return;
+      if (active) repeatDue = true;
+      else start();
+    }, BUSINESS_MESSAGE_REPEAT_MS);
+    const complete = error => {
+      if (active?.attempt !== attempt || generation !== attempt) return;
+      active = null;
+      if (error) {
+        clearRepeat();
+        publish({ playing: false, blocked: true, error: error?.name === "NotAllowedError"
+          ? "Tap anywhere in the business platform to allow message sounds."
+          : "Message sound could not play. Check device volume and audio permissions." });
+        return;
+      }
+      publish({ playing: false, blocked: false, error: "" });
+      if (repeatDue && eligible()) start();
+    };
+    try { Promise.resolve(player.play()).then(() => complete(), complete); }
+    catch (error) { complete(error); }
+  }
+
+  return {
+    getSnapshot: () => state,
+    subscribe(listener) {
+      listeners.add(listener);
+      listener(state);
+      return () => listeners.delete(listener);
+    },
+    update(next) {
+      const scope = validScope(next?.scope), revision = numericRevision(next?.revision);
+      const scopeChanged = scope !== current.scope;
+      if (scopeChanged) silence();
+      current = {
+        scope, enabled: Boolean(next?.enabled), pending: typeof next?.pending === "number" ? next.pending > 0 : Boolean(next?.pending),
+        revision, orderAlarmActive: Boolean(next?.orderAlarmActive)
+      };
+      publish(scopeChanged ? { blocked: false, error: "" } : {});
+      if (!eligible()) { silence(); return; }
+      // Repeated polls, route renders and count changes do not restart an active melody/cadence.
+      if (!active && timer === null && !state.blocked) start();
+    },
+    acknowledge({ scope, revision, unreadCount } = {}) {
+      // This is called only with the successful server read response for the
+      // conversation the user opened. A racing newer arrival must keep ringing.
+      if (validScope(scope) !== current.scope || !current.scope || unreadCount !== 0 || !Number.isSafeInteger(revision) || revision < current.revision || revision < 0) return false;
+      acknowledged.set(current.scope, Math.max(acknowledged.get(current.scope) ?? -1, revision));
+      silence();
+      return true;
+    },
+    // Call synchronously from the shell's trusted click/key handler.
+    interact() {
+      if (!eligible()) return;
+      if (state.blocked) publish({ blocked: false, error: "" });
+      if (!active && timer === null) start();
+    },
+    stop() {
+      current = { scope: "", enabled: false, pending: false, revision: 0, orderAlarmActive: false };
+      silence({ alwaysPause: true });
+    }
+  };
+}
diff --git a/frontend/src/components/cal-eats/business-message-melody-player.js b/frontend/src/components/cal-eats/business-message-melody-player.js
