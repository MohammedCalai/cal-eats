+++ b/frontend/src/components/cal-eats/workspace-model.test.mjs
@@ -0,0 +1,139 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import {readFileSync} from 'node:fs';
+import { CAL_EATS_ORIGIN, WORKSPACE_STATE, WORKSPACE_TOOLS, workspaceStateFromMessage, navigateWorkspaceMessage, workspaceViewForPath, workspacePath, displayOrderCount, displayTotalCount, workspaceIframeAllow, workspaceOrigin, requestedWorkspace, workspaceLoginPath, ownerDashboardAfterLogin } from './workspace-model.mjs';
+const id = digit => `${digit.repeat(8)}-${digit.repeat(4)}-4${digit.repeat(3)}-8${digit.repeat(3)}-${digit.repeat(12)}`;
+const source = {}, nativeUser = { id: id('1'), businessId: id('2'), role: 'BUSINESS_OWNER' };
+function data() { return { type: WORKSPACE_STATE, version: 1, authenticated: true, workspaceMode: 'both', principalKind: 'human', tabletMode: null, business: { id: id('3'), name: 'Independent restaurant' }, products: { calai: { adminAllowed: true, linked: true, ready: true, effectiveStatus: 'active', sourceAccountId: nativeUser.businessId, verifiedSourceUserId: nativeUser.id }, 'cal-eats': { adminAllowed: true, linked: true, ready: true, effectiveStatus: 'active' } }, counters: { calai: { today: 4, available: true }, 'cal-eats': { today: 6, available: true } }, capabilities: { viewOrders: true, viewPayouts: false, manageMenu: false, viewDevices: true } }; }
+const event = value => ({ origin: CAL_EATS_ORIGIN, source, data: value });
+
+test('iframe permissions grant only the fixed child origin and prefer loopback without modern LAN access', () => {
+  const modern = workspaceIframeAllow(['autoplay', 'local-network-access', 'local-network', 'loopback-network']);
+  assert.equal(modern, 'autoplay https://eats.calai.info; loopback-network https://eats.calai.info');
+  assert.equal(modern.includes('local-network'), false);
+  for (const features of [undefined, null, [], ['autoplay', 'local-network-access'], ['loopback-network https://attacker.invalid', '*']]) {
+    assert.equal(workspaceIframeAllow(features), 'autoplay https://eats.calai.info; local-network-access https://eats.calai.info');
+  }
+  assert.equal(workspaceIframeAllow(['loopback-network', '*', 'camera', 'microphone', 'https://attacker.invalid']), modern);
+});
+
+test('the actual persistent iframe applies bounded permission delegation without changing sandbox or authentication', () => {
+  const component = readFileSync(new URL('./CalEatsWorkspace.jsx', import.meta.url), 'utf8');
+  assert.match(component, /if \(!current\?\.enabled\) return children/);
+  assert.match(component, /<iframe[^>]*src=\{childUrl\}[^>]*allow=\{iframeAllow\}/);
+  assert.match(component, /workspaceIframeAllow\(policy\?\.features\?\.\(\), childOrigin\)/);
+  assert.match(component, /sandbox="allow-scripts allow-same-origin allow-forms allow-downloads allow-modals allow-popups allow-popups-to-escape-sandbox"/);
+  assert.doesNotMatch(component, /allow-top-navigation|allow="[^"\n]*\*|Cookies\.(?:set|remove)|localStorage\.(?:setItem|removeItem|clear)|Authorization|fetch\(/);
+});
+
+test('native Calai does not enable Both unless the owner has explicitly opened the combined dashboard', () => {
+  assert.equal(requestedWorkspace('/owner/dashboard', ''), null);
+  assert.equal(requestedWorkspace('/owner/dashboard', '?workspace=both'), 'both');
+  assert.equal(requestedWorkspace('/owner/dashboard', '?workspace=calai'), 'calai');
+  assert.equal(requestedWorkspace('/owner/settings', '?workspace=both'), null);
+  assert.equal(requestedWorkspace('/owner/dashboard', '?workspace=both&workspace=calai'), null);
+  assert.equal(workspaceOrigin(false, 'http://127.0.0.1:4399'), CAL_EATS_ORIGIN);
+  assert.equal(workspaceOrigin(true, 'http://127.0.0.1:4399'), 'http://127.0.0.1:4399');
+  for (const invalid of ['https://127.0.0.1:4399', 'http://other.invalid:4399', 'http://127.0.0.1:65536', 'http://127.0.0.1:4399/extra']) {
+    assert.equal(workspaceOrigin(true, invalid), CAL_EATS_ORIGIN);
+  }
+});
+
+test('an ordinary native sign-in retains only the fixed Both presentation flag through expired and parallel unauthorised reads', () => {
+  const start = new URL('https://calai.info/owner/dashboard?workspace=both&returnTo=https://elsewhere.invalid');
+  const signIn = new URL(workspaceLoginPath(start.pathname, start.search), start.origin);
+  assert.equal(signIn.href, 'https://calai.info/auth/login?workspace=both');
+  assert.equal(workspaceLoginPath(signIn.pathname, signIn.search), '/auth/login?workspace=both');
+  assert.equal(ownerDashboardAfterLogin(signIn.search), '/owner/dashboard?workspace=both');
+  assert.equal(workspaceLoginPath('/admin/dashboard', start.search), '/auth/login');
