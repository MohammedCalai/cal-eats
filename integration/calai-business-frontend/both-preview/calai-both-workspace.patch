index 0000000000000000000000000000000000000000..9265a0087c75ddf30d50ac31aaf32a66c5676776
--- /dev/null
+++ b/frontend/src/components/cal-eats/workspace-live-stats.mjs
@@ -0,0 +1,22 @@
+const callFields = ["activeCalls", "agentsInUse", "ringing", "queued", "forwarding"];
+const orderFields = ["liveOrders", "pendingConfirmation", "confirmedInKitchen", "readyForHandover"];
+
+function counts(source, fields) {
+  if (!source || !fields.every(field => Number.isSafeInteger(source[field]) && source[field] >= 0)) return null;
+  return Object.fromEntries(fields.map(field => [field, source[field]]));
+}
+
+export function workspaceLiveStats(payload) {
+  return {
+    calaiLiveCalls: counts(payload?.calaiLiveCalls, callFields),
+    eatsLiveOrders: counts(payload?.eatsLiveOrders, orderFields),
+  };
+}
+
+export function recordedPhoneOrderValue(insights, stats, field) {
+  if (field !== 'todayValue' && field !== 'value') return null;
+  const amount = Object.hasOwn(insights?.orders || {}, field) ? insights.orders[field] : stats?.orderValue?.[field];
+  if (typeof amount !== 'number' && !(typeof amount === 'string' && /^\d+(?:\.\d+)?$/.test(amount))) return null;
+  const value = Number(amount);
+  return Number.isFinite(value) && value >= 0 ? value : null;
+}
diff --git a/frontend/src/components/cal-eats/workspace-model.mjs b/frontend/src/components/cal-eats/workspace-model.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..3a6e24418bd3aec846cde146b9dbace7b91669d2
--- /dev/null
+++ b/frontend/src/components/cal-eats/workspace-model.mjs
@@ -0,0 +1,160 @@
+import { workspaceLiveStats } from './workspace-live-stats.mjs';
+
+export const CAL_EATS_ORIGIN = 'https://eats.calai.info';
+export const CAL_EATS_EMBED = CAL_EATS_ORIGIN + '/business/embedded';
+export const WORKSPACE_STATE = 'cal-eats-workspace:state';
+export const WORKSPACE_NAVIGATE = 'cal-eats-workspace:navigate';
+export const WORKSPACE_TOOLS = Object.freeze([
+  { view: 'orders', label: 'Orders', icon: 'lucide:receipt-text', permission: 'viewOrders' },
+  { view: 'reports', label: 'Tools & reports', icon: 'lucide:chart-column', permission: 'viewOrders' },
+  { view: 'menu', label: 'Menu', icon: 'lucide:notebook-tabs', permission: 'manageMenu' },
+  { view: 'inbox', label: 'Customer messages', icon: 'lucide:message-square', permission: 'viewInbox' },
+  { view: 'customers', label: 'Customers', icon: 'lucide:users', permission: 'viewCustomers' },
+  { view: 'offers', label: 'Marketing', icon: 'lucide:tag', permission: 'manageMarketing' },
+  { view: 'support', label: 'Support', icon: 'lucide:life-buoy', permission: 'viewSupport' },
+  { view: 'payouts', label: 'Earnings & payouts', icon: 'lucide:wallet', permission: 'viewPayouts' },
+  { view: 'settings', label: 'Settings', icon: 'lucide:settings', permission: 'manageSettings' },
+  { view: 'notifications', label: 'Notifications', icon: 'lucide:bell', permission: 'viewOrders' },
+  { view: 'statements', label: 'Statements', icon: 'lucide:files', permission: 'viewOrders' },
+]);
+export const WORKSPACE_VIEWS = Object.freeze(['background', 'dashboard', 'accounts', 'devices', ...WORKSPACE_TOOLS.map(tool => tool.view)]);
+
+export function workspaceOrigin(development, previewOrigin) {
+  if (development && typeof previewOrigin === 'string' && /^http:\/\/127\.0\.0\.1:[1-9]\d{0,4}$/.test(previewOrigin)) {
+    const port = Number(previewOrigin.split(':').at(-1));
+    if (port <= 65535) return previewOrigin;
+  }
+  return CAL_EATS_ORIGIN;
+}
+
+export function requestedWorkspace(pathname, search) {
+  if (pathname !== '/owner/dashboard') return null;
+  const workspace = new URLSearchParams(search).getAll('workspace');
+  return workspace.length === 1 && ['both', 'calai'].includes(workspace[0]) ? workspace[0] : null;
+}
+
+const bothQuery = '?workspace=both';
+
+export function workspaceLoginPath(pathname, search) {
+  const presentationPath = pathname === '/auth/login' ? '/owner/dashboard' : pathname;
+  const suffix = requestedWorkspace(presentationPath, search) === 'both' ? bothQuery : '';
+  return '/auth/login' + suffix;
+}
+
+export function ownerDashboardAfterLogin(search) {
+  const suffix = requestedWorkspace('/owner/dashboard', search) === 'both' ? bothQuery : '';
+  return '/owner/dashboard' + suffix;
+}
+// A modern browser can delegate loopback without also granting LAN access.
+// Older managed Edge uses its documented combined Local Network Access token.
+// Delegation is limited to this child origin; it never authorises a terminal.
+export function workspaceIframeAllow(supportedFeatures = [], origin = CAL_EATS_ORIGIN) {
+  const loopbackFeature = Array.isArray(supportedFeatures) && supportedFeatures.includes('loopback-network') ? 'loopback-network' : 'local-network-access';
+  return `autoplay ${origin}; ${loopbackFeature} ${origin}`;
+}
+const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+const isId = value => typeof value === 'string' && UUID.test(value);
+const plain = value => Boolean(value && typeof value === 'object' && !Array.isArray(value) && Object.getPrototypeOf(value) === Object.prototype);
+const bounded = (value, size) => typeof value === 'string' && value.length > 0 && value.length <= size && !/[\u0000-\u001f\u007f]/.test(value);
+export function workspaceNativeDestination(event, sourceWindow, origin = CAL_EATS_ORIGIN) {
+  const value = event.data;
+  if (!sourceWindow || event.source !== sourceWindow || event.origin !== origin || !plain(value) ||
+      value.version !== 1 || value.type !== 'cal-eats-workspace:open-native') return null;
+  if (value.view === 'settings') return '/owner/settings';
+  if (value.view === 'subscription') return '/owner/settings/subscription';
+  return null;
+}
+export function workspaceCheckoutUrl(value) {
+  try {
+    const url = new URL(value);
+    return url.origin === 'https://checkout.stripe.com' && !url.username && !url.password ? url.href : null;
+  } catch { return null; }
+}
+const sameId = (a, b) => typeof a === 'string' && typeof b === 'string' && UUID.test(a) && UUID.test(b) && a.toLowerCase() === b.toLowerCase();
+const permitted = product => product.adminAllowed && product.linked && product.ready;
+const validCount = value => Number.isSafeInteger(value) && value >= 0;
+function product(value) {
+  if (!plain(value) || ['adminAllowed', 'linked', 'ready'].some(key => typeof value[key] !== 'boolean') || !bounded(value.effectiveStatus, 64)) return null;
+  return { adminAllowed: value.adminAllowed, linked: value.linked, ready: value.ready, effectiveStatus: value.effectiveStatus };
+}
+function counter(value) {
+  if (!plain(value) || typeof value.available !== 'boolean' || value.today !== null && (!Number.isSafeInteger(value.today) || value.today < 0)) return null;
+  if (value.available && value.today === null) return null;
+  return { available: value.available, today: value.available ? value.today : null };
+}
+export function workspaceStateFromMessage(event, sourceWindow, nativeUser, origin = CAL_EATS_ORIGIN) {
+  if (!sourceWindow || event?.source !== sourceWindow || event.origin !== origin) return null;
+  const value = event.data;
+  if (!plain(value) || value.type !== WORKSPACE_STATE || value.version !== 1 || typeof value.authenticated !== 'boolean') return null;
+  if (!value.authenticated) return { authenticated: false, business: null, products: null, counters: null, capabilities: {}, orders: [], pendingOrderCount: null, matchesNativeAccount: false, combined: false };
+  if (!plain(value.business) || !isId(value.business.id) || !bounded(value.business.name, 160) || !plain(value.products) || !plain(value.counters)) return null;
+  const calai = product(value.products.calai), eats = product(value.products['cal-eats']);
+  const calaiCounter = counter(value.counters.calai), eatsCounter = counter(value.counters['cal-eats']);
+  if (!calai || !eats || !calaiCounter || !eatsCounter) return null;
+  const source = value.products.calai;
+  eats.sourceAccountId = isId(value.products['cal-eats'].sourceAccountId) ? value.products['cal-eats'].sourceAccountId : null;
+  const matchesNativeAccount = nativeUser?.role === 'BUSINESS_OWNER' && sameId(source.sourceAccountId, nativeUser.businessId) && sameId(source.verifiedSourceUserId, nativeUser.id);
+  const scopedMode = value.workspaceMode === 'both' &&
+    (value.principalKind === 'terminal' && value.tabletMode === 'both' ||
+     value.principalKind === 'human' && (value.tabletMode === null || value.tabletMode === 'both'));
+  const combined = matchesNativeAccount && scopedMode && permitted(calai) && permitted(eats);
+  const capabilities = {};
+  for (const { permission } of WORKSPACE_TOOLS) capabilities[permission] = combined && plain(value.capabilities) && value.capabilities[permission] === true;
+  const orders = combined && capabilities.viewOrders ? recentOrders(value.orders) : [];
+  const pendingOrderCount = combined && capabilities.viewOrders && validCount(value.pendingOrderCount) ? value.pendingOrderCount : null;
+  const counters = combined ? { calai: calaiCounter, 'cal-eats': eatsCounter } : null;
+  const messageAttention = combined && (capabilities.viewInbox || capabilities.viewOrders)
+    ? readMessageAttention(value.messageAttention) : null;
+  const receipt = value.presentationReceipt;
+  const presentationReceipt = combined && value.tabletMode === 'both' && plain(receipt) &&
+    isId(receipt.tabletId) && Number.isSafeInteger(receipt.revision) && receipt.revision >= 1
+    ? { tabletId: receipt.tabletId, revision: receipt.revision } : null;
+  return { authenticated: true, business: combined ? { id: value.business.id, name: value.business.name } : null,
+    counters, capabilities, orders, pendingOrderCount, messageAttention, presentationReceipt, matchesNativeAccount, combined,
+    ...workspaceLiveStats(combined && capabilities.viewOrders ? value : null) };
+}
+
+function readMessageAttention(value) {
+  if (!plain(value) || !validCount(value.unreadCount) || !validCount(value.revision) ||
+      !Number.isSafeInteger(value.acknowledgedRevision) || value.acknowledgedRevision < -1 ||
+      value.acknowledgedRevision > value.revision || typeof value.soundEnabled !== 'boolean' ||
+      typeof value.orderAlarmActive !== 'boolean') return null;
+  const { unreadCount, revision, acknowledgedRevision, soundEnabled, orderAlarmActive } = value;
+  return { unreadCount, revision, acknowledgedRevision, soundEnabled, orderAlarmActive };
+}
+
+const orderStatuses = new Set(['received', 'unconfirmed', 'confirmed', 'placed', 'accepted', 'preparing', 'ready', 'out_for_delivery', 'completed', 'rejected', 'cancelled', 'expired']);
+function recentOrders(orders) {
+  if (!Array.isArray(orders)) return [];
+  return orders.slice(0, 8).filter(row => plain(row) && ['calai', 'cal-eats'].includes(row.source)
+      && orderStatuses.has(row.status) && typeof row.createdAt === 'string' && Number.isFinite(Date.parse(row.createdAt))
+      && ['delivery', 'collection', 'takeaway', 'unknown'].includes(row.fulfilment))
+    .map(({ source, status, createdAt, fulfilment, totalMinor, sourceOrderId }) => ({
+      source, status, createdAt, fulfilment, totalMinor: validCount(totalMinor) ? totalMinor : null,
+      ...(source === 'cal-eats' && isId(sourceOrderId) ? { sourceOrderId } : {}),
+    }));
+}
+export function navigateWorkspaceMessage(view, orderId = null) {
+  if (!WORKSPACE_VIEWS.includes(view)) throw new Error('Unsupported Cal-Eats workspace view');
+  return { type: WORKSPACE_NAVIGATE, version: 1, view, ...(view === 'orders' && isId(orderId) ? { orderId } : {}) };
+}
+export function workspaceViewForPath(pathname) {
+  if (pathname === '/owner/accounts-connections') return 'accounts';
+  const match = /^\/owner\/cal-eats\/([a-z]+)$/.exec(pathname);
+  return match && WORKSPACE_TOOLS.some(tool => tool.view === match[1]) ? match[1] : null;
+}
+export function workspacePath(view) {
+  if (view === 'accounts') return '/owner/accounts-connections';
+  if (!WORKSPACE_TOOLS.some(tool => tool.view === view)) throw new Error('Use the native Calai dashboard route');
+  return '/owner/cal-eats/' + view;
+}
+export function displayOrderCount(state, productName) {
+  const value = state?.counters?.[productName];
+  return value?.available && Number.isSafeInteger(value.today) ? String(value.today) : 'Unavailable';
+}
+export function displayTotalCount(state) {
+  const counters = ['calai', 'cal-eats'].map(product => state?.counters?.[product]);
+  if (!counters.every(counter => counter?.available === true && validCount(counter.today))) return 'Unavailable';
+  const sum = counters[0].today + counters[1].today;
+  return Number.isSafeInteger(sum) ? String(sum) : 'Unavailable';
+}
diff --git a/frontend/src/components/cal-eats/workspace-model.test.mjs b/frontend/src/components/cal-eats/workspace-model.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..9eaa17a69b6d738fc9ce935f7ec14eb066de9c80
--- /dev/null
+++ b/frontend/src/components/cal-eats/workspace-model.test.mjs
@@ -0,0 +1,219 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import {readFileSync} from 'node:fs';
+import { recordedPhoneOrderValue } from './workspace-live-stats.mjs';
+
+test('combined phone order value uses recorded money and never the count or an invented zero', () => {
+  const stats = { orderValue: { todayValue: 9.5, value: 225 } };
+  assert.equal(recordedPhoneOrderValue({ orders:{ today:2, todayValue:15.75 } },stats,'todayValue'),15.75);
+  assert.equal(recordedPhoneOrderValue({ orders:{ today:2 } },stats,'todayValue'),9.5);
+  assert.equal(recordedPhoneOrderValue({ orders:{ today:2, todayValue:null } },stats,'todayValue'),null);
+  assert.equal(recordedPhoneOrderValue({ orders:{ today:0, todayValue:0 } },stats,'todayValue'),0);
+  assert.equal(recordedPhoneOrderValue({ orders:{ today:2, value:'17.75' } },stats,'value'),17.75);
+  assert.equal(recordedPhoneOrderValue({ orders:{ today:2 } },undefined,'todayValue'),null);
+});
+import { CAL_EATS_ORIGIN, WORKSPACE_STATE, WORKSPACE_TOOLS, workspaceStateFromMessage, navigateWorkspaceMessage, workspaceViewForPath, workspacePath, displayOrderCount, displayTotalCount, workspaceIframeAllow, workspaceOrigin, requestedWorkspace, workspaceLoginPath, ownerDashboardAfterLogin } from './workspace-model.mjs';
+const id = digit => `${digit.repeat(8)}-${digit.repeat(4)}-4${digit.repeat(3)}-8${digit.repeat(3)}-${digit.repeat(12)}`;
+const source = {}, nativeUser = { id: id('1'), businessId: id('2'), role: 'BUSINESS_OWNER' };
+function data() { return { type: WORKSPACE_STATE, version: 1, authenticated: true, workspaceMode: 'both', principalKind: 'human', tabletMode: null, business: { id: id('3'), name: 'Independent restaurant' }, products: { calai: { adminAllowed: true, linked: true, ready: true, effectiveStatus: 'active', sourceAccountId: nativeUser.businessId, verifiedSourceUserId: nativeUser.id }, 'cal-eats': { adminAllowed: true, linked: true, ready: true, effectiveStatus: 'active' } }, counters: { calai: { today: 4, available: true }, 'cal-eats': { today: 6, available: true } }, capabilities: { viewOrders: true, viewPayouts: false, manageMenu: false, viewDevices: true } }; }
+const event = value => ({ origin: CAL_EATS_ORIGIN, source, data: value });
+
+test('native presentation receipt is scoped to the matched owner and current combined tablet', () => {
+  const packet = { ...data(), tabletMode:'both', presentationReceipt:{tabletId:id('8'),revision:4,extra:'ignored'} };
+  const parse = value => workspaceStateFromMessage(event(value), source, nativeUser).presentationReceipt;
+  assert.deepEqual(parse(packet),{tabletId:id('8'),revision:4});
+  assert.equal(parse({...packet,tabletMode:null}),null);
+  assert.equal(parse({...packet,presentationReceipt:{tabletId:id('8'),revision:0}}),null);
+  assert.equal(workspaceStateFromMessage(event(packet),source,{...nativeUser,businessId:id('7')}).presentationReceipt,null);
+});
+
+test('unread totals and sound metadata are scoped to the connected business and its conversation permissions', () => {
+  const value = data();
+  const attention = { unreadCount: 3, revision: 7, acknowledgedRevision: 6, soundEnabled: true, orderAlarmActive: false };
+  value.capabilities.viewOrders = false;
+  value.messageAttention = { ...attention, message: 'private' };
+  const read = () => workspaceStateFromMessage(event(value), source, nativeUser).messageAttention;
+  assert.equal(read(), null);
+  value.capabilities.viewInbox = true;
+  assert.deepEqual(read(), attention);
+  value.capabilities.viewInbox = false;
+  value.capabilities.viewOrders = true;
+  assert.deepEqual(read(), attention);
+  value.messageAttention.acknowledgedRevision = 8;
+  assert.equal(read(), null);
+  value.messageAttention = attention;
+  value.workspaceMode = 'calai';
+  assert.equal(read(), null);
+  value.workspaceMode = 'both';
+  value.products.calai.verifiedSourceUserId = id('5');
+  assert.equal(read(), null);
+});
+
+test('iframe permissions grant only the fixed child origin and prefer loopback without modern LAN access', () => {
+  const modern = workspaceIframeAllow(['autoplay', 'local-network-access', 'local-network', 'loopback-network']);
+  assert.equal(modern, 'autoplay https://eats.calai.info; loopback-network https://eats.calai.info');
+  assert.equal(modern.includes('local-network'), false);
+  for (const features of [undefined, null, [], ['autoplay', 'local-network-access'], ['loopback-network https://attacker.invalid', '*']]) {
+    assert.equal(workspaceIframeAllow(features), 'autoplay https://eats.calai.info; local-network-access https://eats.calai.info');
