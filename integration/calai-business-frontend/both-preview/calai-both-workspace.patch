@@ -0,0 +1,70 @@
+.both-activity-title, .both-activity-heading {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: baseline;
+  justify-content: space-between;
+  gap: .4rem .75rem;
+}
+.both-activity-title h2 {
+  color: #f6f7fa;
+  font-size: 1.35rem;
+  font-weight: 650;
+}
+.both-activity-title > span, .both-activity-heading > span {
+  color: #b8c1ce;
+  font-size: .84rem;
+  font-variant-numeric: tabular-nums;
+}
+.both-activity-title strong { color: #fff; }
+.both-activity-grid {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: clamp(.65rem, 1.5vw, 1.15rem);
+}
+.both-activity-card {
+  --accent: #bad8ff;
+  --border: #32425b;
+  --glow: #2d5b9755;
+  --surface: #161d2a;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  min-width: 0;
+  gap: .75rem;
+  border: 1px solid var(--border);
+  border-radius: 1rem;
+  background: radial-gradient(ellipse at 50% 43%, var(--glow), transparent 65%), linear-gradient(165deg, var(--surface), #15161c 87%);
+  padding: clamp(.8rem, 1.7vw, 1.25rem);
+}
+.both-activity-card--calai { --accent: #dbccff; --border: #483d5e; --glow: #6747ad51; --surface: #211b2f; }
+.both-activity-heading { align-self: stretch; align-items: center; }
+.both-activity-heading h3 { font-size: clamp(1.05rem, 2vw, 1.35rem); font-weight: 650; color: #fff; }
+.both-activity-card .live-order-orbit {
+  width: min(100%, clamp(130px, 16vw, 205px));
+  aspect-ratio: 1;
+  position: relative;
+  isolation: isolate;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: .28rem;
+}
+.both-activity-card .live-order-orbit-art {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+  z-index: -1;
+  filter: drop-shadow(0 5px 10px #07081285);
+}
