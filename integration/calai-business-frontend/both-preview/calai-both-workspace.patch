diff --git a/frontend/src/components/cal-eats/useHostedMessageReminder.js b/frontend/src/components/cal-eats/useHostedMessageReminder.js
new file mode 100644
index 0000000000000000000000000000000000000000..286b15d899e961c8ce427adf645453eab65f8258
--- /dev/null
+++ b/frontend/src/components/cal-eats/useHostedMessageReminder.js
@@ -0,0 +1,57 @@
+import { useEffect, useRef, useState } from 'react';
+import { createBusinessMessageAudio } from './business-message-audio.js';
+import { createBusinessMessageMelody } from './business-message-melody-player.js';
+
+const quiet = { blocked: false, error: '', playing: false };
+
+export function useHostedMessageReminder(scope, attention, frameRef, childOrigin) {
+  const audio = useRef(null);
+  const latest = useRef(attention);
+  latest.current = attention;
+  const [state, setState] = useState(quiet);
+
+  useEffect(() => {
+    if (!scope) { setState(quiet); return; }
+    const player = createBusinessMessageMelody();
+    const controller = createBusinessMessageAudio(player);
+    audio.current = controller;
+    const unsubscribe = controller.subscribe(setState);
+    const prepare = () => {
+      if (latest.current?.soundEnabled === false) return;
+      void player.prepare().catch(() => {});
+      controller.interact();
+    };
+    const interact = event => { if (event.isTrusted) prepare(); };
+    // A tap inside the Cal-Eats frame activates its ancestors too, but pointer
+    // events don't bubble across documents. The frame signals that actual tap.
+    const frameInteraction = event => {
+      if (!frameRef?.current || event.source !== frameRef.current.contentWindow || event.origin !== childOrigin ||
+          event.data?.type !== 'cal-eats-workspace:audio-interaction' || event.data.version !== 1 ||
+          event.data.businessId !== scope || navigator.userActivation?.hasBeenActive === false) return;
+      prepare();
+    };
+    document.addEventListener('pointerdown', interact, true);
+    document.addEventListener('keydown', interact, true);
+    window.addEventListener('message', frameInteraction);
+    return () => {
+      unsubscribe();
+      document.removeEventListener('pointerdown', interact, true);
+      document.removeEventListener('keydown', interact, true);
+      window.removeEventListener('message', frameInteraction);
+      audio.current = null;
+      controller.stop();
+      player.dispose();
+    };
+  }, [scope, frameRef, childOrigin]);
+
+  useEffect(() => {
+    if (!audio.current) return;
+    audio.current.update({
+      scope, enabled: attention?.soundEnabled === true, revision: attention?.revision ?? 0,
+      pending: attention && attention.unreadCount > 0 && attention.revision > attention.acknowledgedRevision,
+      orderAlarmActive: attention?.orderAlarmActive === true,
+    });
+  }, [scope, attention?.unreadCount, attention?.soundEnabled, attention?.revision,
+    attention?.acknowledgedRevision, attention?.orderAlarmActive, frameRef, childOrigin]);
+  return scope ? state : quiet;
+}
