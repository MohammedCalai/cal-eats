+test('pending counts and combined display rows include only authorized, bounded, non-customer order data', () => {
+  const value = data();
+  const order = { source: 'cal-eats', status: 'placed', createdAt: '2026-11-27T12:00:00Z', fulfilment: 'delivery', totalMinor: 800 };
+  value.pendingOrderCount = 2;
+  value.orders = [{ ...order, customerAddress: 'must-not-propagate', id: 'must-not-propagate' },
+    { ...order, source: 'other' },
+    { ...order, source: 'calai', status: 'confirmed' }];
+  const state = workspaceStateFromMessage(event(value), source, nativeUser);
