{
  "name": "calai-eats",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "portal:build": "npm run build --workspace=@cal-eats/portal",
    "portal:dev": "npm run dev --workspace=@cal-eats/portal",
    "mobile:check": "npm run typecheck --workspace=@cal-eats/mobile",
    "admin:mobile:check": "npm run typecheck --workspace=@cal-eats/admin-mobile",
    "admin:mobile:start": "npm run start --workspace=@cal-eats/admin-mobile",
    "load:local": "node scripts/load-marketplace.js",
    "db:migrate": "node --env-file-if-exists=.env apps/api/src/cli/migrate.js",
    "db:check": "node --env-file-if-exists=.env scripts/database-check.js",
    "db:seed": "node --env-file-if-exists=.env apps/api/src/cli/seed.js",
    "admin:create": "node --env-file-if-exists=.env apps/api/scripts/bootstrap-admin.js",
    "start": "node --env-file-if-exists=.env apps/api/src/main.js",
    "stripe:sandbox:check": "node --env-file=.env.stripe-test scripts/stripe-sandbox-check.js",
    "smoke": "node apps/api/scripts/smoke.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "restore:check": "node --env-file-if-exists=.env scripts/restore-check.js",
    "test": "npm run test:core && npm run test:mobile",
    "test:core": "node --test apps/api/test/*.test.js apps/web/test/*.test.js apps/portal/test/*.test.js apps/print-bridge/test/*.test.js scripts/*.test.js",
    "test:mobile": "npm test --workspace=@cal-eats/mobile && npm test --workspace=@cal-eats/admin-mobile",
    "check:developer": "node scripts/developer-check.js",
    "check": "node --check apps/api/src/main.js && node --check apps/api/src/app.js && node --check apps/api/src/journey.js && node --check apps/api/src/operations.js && node --check apps/api/src/product.js && node --check apps/api/src/availability.js && node --check apps/api/src/static.js && node --check apps/api/src/payments/mock.js && node --check apps/api/scripts/smoke.js && node --check scripts/backup.js && node --check scripts/restore-check.js && npm test",
    "release:check": "node scripts/release-check.js",
    "mail:connect": "node --env-file=.env.order-alerts scripts/connect-service-mail.js --connect --confirm-send-only-mailbox",
    "mail:check": "node --env-file=.env.order-alerts scripts/connect-service-mail.js",
    "migration:export": "node scripts/export-migration-package.js",
    "mail:send-check": "node --env-file=.env.order-alerts scripts/check-service-mail.js"
  },
  "engines": {
    "node": "24.19.0",
    "npm": "11.17.0"
  },
  "packageManager": "npm@11.17.0"
}
